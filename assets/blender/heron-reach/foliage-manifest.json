  "textures": [
    {
      "files": [
        "plane-leaf-atlas-color.webp",
        "plane-leaf-atlas-normal.webp"
      ],
      "material": "hr_leaf_plane",
      "method": "numpy: palmate 3-5 lobed outline from a soft-max of pointed polar lobes with coarse teeth; primary and secondary veins as distance fields; autumn palette yellow-green to tan and brown with blotch noise and browned margins; 2x supersampled; normal from a dome-plus-vein height map; colour bled under transparent pixels (pull-push) to stop mip fringes. Seed 4101."
    },
    {
      "files": [
        "birch-leaf-atlas-color.webp",
        "birch-leaf-atlas-normal.webp"
      ],
      "material": "hr_leaf_birch",
      "method": "numpy: deltoid-ovate outline with acuminate tip and double serration, midrib and seven straight vein pairs; yellow-green to gold palette; clusters on thin dark twigs. Seed 4202."
    },
    {
      "files": [
        "plane-bark-color.webp",
        "plane-bark-normal.webp",
        "plane-bark-orm.webp"
      ],
      "material": "hr_bark_plane",
      "method": "numpy: two scales of periodic, domain-warped Worley cells; each plate gets a bark age (cream, olive, grey-green, grey-brown); small flakes peel to younger layers; softened rims, rain streaks and algae tint; height from age steps; ORM = cavity AO, roughness by age, metal 0. Tiles both ways, 1 tile = 1 m. Seed 4808."
    },
    {
      "files": [
        "birch-bark-color.webp",
        "birch-bark-normal.webp",
        "birch-bark-orm.webp"
      ],
      "material": "hr_bark_birch",
      "method": "numpy: cream-white base with grey mottling and pinkish peeled bands; 300 wrapped horizontal lenticel dashes; ragged dark fissured patches from thresholded periodic noise. Black trunk base and dark twigs come from vertex colour (COLOR_0) multiplied in the material. Seed 4909."
    },
    {
      "files": [
        "grass-blades-color.webp",
        "grass-blades-normal.webp"
      ],
      "material": "hr_grass_blade",
      "method": "numpy: twelve 64 px blade columns (damp dark greens, two yellowed) with keeled midrib, striations, darker base and ragged dried straw tips of random length; two side-view tuft cards drawn as tapered Bezier blades. Seed 4606."
    },
    {
      "files": [
        "weeds-color.webp",
        "weeds-normal.webp"
      ],
      "material": "hr_weed",
      "method": "numpy: runcinate dandelion leaves, plantain leaves with parallel veins, a grassy crack weed with seed panicles and a groundsel-type sprig with muted yellow heads. Seed 4707."
    },
    {
      "files": [
        "leaf-litter-color.webp",
        "leaf-litter-normal.webp"
      ],
      "material": "hr_leaf_litter",
      "method": "numpy: 4 x 4 grid of fallen plane and birch leaves in wet browns, with dark wet spotting, holes, curl in the height map. Seed 4505."
    },
    {
      "files": [
        "hedge-leaf-atlas-color.webp",
        "hedge-leaf-atlas-normal.webp"
      ],
      "material": "hr_hedge_leaf",
      "method": "numpy: privet sprigs with opposite small glossy elliptic leaves, an opaque inner-foliage tile (900 overlapping leaves darkened by depth) for the hidden core, small sprig singles. Seed 4404."
    },
    {
      "files": [
        "shrub-leaf-atlas-color.webp",
        "shrub-leaf-atlas-normal.webp"
      ],
      "material": "hr_shrub_leaf",
      "method": "numpy: evergreen laurel-type oval leaves with fine serration, a few bronze older leaves, on green twigs. Seed 4303."
    }
  ],
  "materials": {
    "all": "Principled BSDF; colour images sRGB, normal and ORM Non-Color; OpenGL normals.",
    "alpha": "Leaf, grass, weed, hedge and litter materials feed image alpha through a Math Round node (alpha clip at 0.5) and have backface culling off, so glTF exports alphaMode MASK, doubleSided.",
    "bark": "hr_bark_plane and hr_bark_birch multiply the base colour by the Col vertex colour attribute (glTF COLOR_0). Occlusion via the glTF Material Output group from the ORM red channel.",
    "normals": "Leaf cards carry custom normals blended towards the canopy radial direction so crowns light softly; grass normals lean towards +Z so lawns light like the ground."
  }
}