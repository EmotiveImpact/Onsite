{
  "name": "onsite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:legacy && tsx --test tests/wwb-navigation.test.ts tests/estate-assets.test.ts",
    "test:browser": "node scripts/verify-encounter.mjs",
    "typecheck": "tsc --noEmit",
    "test:legacy": "node --test --test-isolation=none tests/simulation.test.js",
    "test:browser:legacy": "node scripts/browser-check.mjs",
    "evidence:layout": "tsx scripts/layout-evidence.ts",
    "evidence:route": "node scripts/capture-route.mjs",
    "assets:estate": "npm run evidence:layout && blender -b --python-exit-code 1 --python scripts/build-estate.py && npm run evidence:layout && blender -b --python-exit-code 1 --python scripts/export_estate.py"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
